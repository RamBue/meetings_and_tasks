PORT=5002
MONGODB_URI=mongodb://mongo:27017/<db>
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Anmeldung: alle drei Werte sind nötig, sonst ist keine Anmeldung möglich
AUTH_USER=<benutzername>
# Im Ordner backend "npm run hash-password" ausführen und die Ausgabe hier einsetzen
AUTH_PASSWORD_HASH=<ausgabe-von-npm-run-hash-password>
# Zufälliger Text mit mindestens 32 Zeichen, zum Beispiel erzeugt mit:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<zufaelliger-text>
# Optional: wie lange eine Anmeldung gültig bleibt (Standard 7d)
# JWT_EXPIRES_IN=7d
