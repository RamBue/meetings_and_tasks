{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "title": "User",
    "properties": {
        "_id": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "email": {
            "type": "string"
        },
        "createdAt": {
            "type": "string",
            "format": "date"
        },
        "updatedAt": {
            "type": "string",
            "format": "date"
        }
    },
    "additionalProperties": false,
    "required": [
        "name",
        "email"
    ]
}